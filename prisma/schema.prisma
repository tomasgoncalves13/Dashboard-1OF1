// Dashboard-1OF1 — Prisma schema
// Single source of truth for the database.
// Monetary fields use Decimal(14,2). Quantities use Int. Timestamps in UTC.
// All FKs are explicit. Indexes added on every frequently-filtered column.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// AUTH & TENANCY
// ─────────────────────────────────────────────────────────────

model AppUser {
  id          String   @id @db.Uuid
  email       String   @unique
  fullName    String?
  avatarUrl   String?
  role        UserRole @default(OWNER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores    Store[]
  expenses  Expense[]
  auditLogs AuditLog[]

  @@map("app_users")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

// ─────────────────────────────────────────────────────────────
// STORES & INTEGRATIONS
// ─────────────────────────────────────────────────────────────

model Store {
  id            String   @id @default(cuid())
  ownerId       String   @db.Uuid
  name          String
  shopifyDomain String?  @unique
  currency      String   @default("EUR") @db.Char(3)
  timezone      String   @default("Europe/Lisbon")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner               AppUser             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  integrations        Integration[]
  products            Product[]
  variants            ProductVariant[]
  orders              Order[]
  customers           Customer[]
  suppliers           Supplier[]
  expenses            Expense[]
  influencers         Influencer[]
  influencerShipments InfluencerShipment[]
  manualSales         ManualSale[]
  adCampaigns         AdCampaign[]
  stockMovements      StockMovement[]
  uploads             Upload[]
  analyticsSnapshots  AnalyticsSnapshot[]
  payouts             Payout[]
  eupagoTransactions  EupagoTransaction[]
  eupagoPayouts       EupagoPayout[]
  orderCostConfig     OrderCostConfig?
  clubs               Club[]
  purchaseOrders      PurchaseOrder[]
  inventoryItems      InventoryItem[]
  grwmScheduledPosts  GrwmScheduledPost[]

  @@index([ownerId])
  @@map("stores")
}

// ─────────────────────────────────────────────────────────────
// ORDER COST CONFIG — per-store fixed per-order overhead costs
// Configurable in Settings. Applied to every online order.
// ─────────────────────────────────────────────────────────────

model OrderCostConfig {
  id               String   @id @default(cuid())
  storeId          String   @unique
  // Free pair of grip socks included in every online order
  freeGiftCost     Decimal  @default(0.88) @db.Decimal(14, 2)
  bubbleMailerCost Decimal  @default(0.69) @db.Decimal(14, 2)
  cardCost         Decimal  @default(0.01) @db.Decimal(14, 2)
  stickerCost      Decimal  @default(0.06) @db.Decimal(14, 2)
  shippingDomestic Decimal  @default(2.34) @db.Decimal(14, 2)
  shippingEU       Decimal  @default(4.25) @db.Decimal(14, 2)
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("order_cost_configs")
}

model Payout {
  id               String   @id @default(cuid())
  storeId          String
  shopifyId        String
  status           String
  issuedAt         DateTime
  net              Decimal  @db.Decimal(14, 2)
  currency         String   @db.Char(3)
  chargesGross     Decimal  @default(0) @db.Decimal(14, 2)
  chargesFee       Decimal  @default(0) @db.Decimal(14, 2)
  refundsGross     Decimal  @default(0) @db.Decimal(14, 2)
  refundsFee       Decimal  @default(0) @db.Decimal(14, 2)
  adjustmentsGross Decimal  @default(0) @db.Decimal(14, 2)
  adjustmentsFee   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([storeId, issuedAt])
  @@index([storeId, status])
  @@map("payouts")
}

model EupagoTransaction {
  id              String   @id @default(cuid())
  storeId         String
  trid            String
  identifier      String?
  reference       String?
  entity          String?
  amount          Decimal  @db.Decimal(14, 2)
  commission      Decimal  @default(0) @db.Decimal(14, 4)
  commissionIva   Decimal  @default(0) @db.Decimal(14, 4)
  totalCommission Decimal  @default(0) @db.Decimal(14, 4)
  net             Decimal  @db.Decimal(14, 2)
  status          String
  method          String?
  channelId       String?
  channelName     String?
  datePayment     DateTime
  dateTransfer    DateTime?
  bookingDate     DateTime?
  source          String   @default("API")
  raw             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, trid])
  @@index([storeId, datePayment])
  @@index([storeId, status])
  @@map("eupago_transactions")
}

model EupagoPayout {
  id          String   @id @default(cuid())
  storeId     String
  status      String
  issuedAt    DateTime
  paymentDate DateTime
  netAmount   Decimal  @db.Decimal(14, 2)
  grossAmount Decimal  @db.Decimal(14, 2)
  commission  Decimal  @default(0) @db.Decimal(14, 2)
  iva         Decimal  @default(0) @db.Decimal(14, 2)
  iban        String?
  fileRef     String
  periodStart DateTime?
  periodEnd   DateTime?
  source      String   @default("CSV")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fileRef])
  @@index([storeId, paymentDate])
  @@map("eupago_payouts")
}

model Integration {
  id           String              @id @default(cuid())
  storeId      String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  accessToken  String?
  refreshToken String?
  scope        String?
  externalId   String?
  metadata     Json?
  lastSyncedAt DateTime?
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([provider, status])
  @@map("integrations")
}

enum IntegrationProvider {
  SHOPIFY
  META_ADS
  GOOGLE_ADS
  STRIPE
  KLAVIYO
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  REVOKED
}

// ─────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  storeId     String
  shopifyId   String?
  title       String
  handle      String?
  description String?
  imageUrl    String?
  vendor      String?
  productType String?
  tags        String[]
  status      ProductStatus @default(ACTIVE)
  supplierId  String?

  // Product-level cost default (inherited by new variants)
  defaultCost   Decimal? @db.Decimal(14, 2)
  packagingCost Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  clubPrices ClubProductPrice[]

  @@unique([storeId, shopifyId])
  @@index([storeId, status])
  @@index([storeId, title])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model ProductVariant {
  id             String  @id @default(cuid())
  storeId        String
  productId      String
  shopifyId      String?
  sku            String?
  barcode        String?
  title          String
  price          Decimal @db.Decimal(14, 2)
  compareAtPrice Decimal? @db.Decimal(14, 2)

  // COGS per unit
  unitCost     Decimal? @db.Decimal(14, 2)
  shippingCost Decimal? @db.Decimal(14, 2)
  packagingCost Decimal? @db.Decimal(14, 2)
  customsCost  Decimal? @db.Decimal(14, 2)

  // Inventory
  stockOnHand   Int  @default(0)
  stockReserved Int  @default(0)
  reorderPoint  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems              OrderItem[]
  manualSaleItems         ManualSaleItem[]
  influencerShipmentItems InfluencerShipmentItem[]
  stockMovements          StockMovement[]
  components              VariantComponent[]

  @@unique([storeId, shopifyId])
  @@index([storeId, sku])
  @@index([productId])
  @@index([storeId, stockOnHand])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  storeId        String
  shopifyId      String?
  email          String?
  firstName      String?
  lastName       String?
  phone          String?
  country        String?
  city           String?
  marketingOptIn Boolean  @default(false)
  ordersCount    Int      @default(0)
  totalSpent     Decimal  @default(0) @db.Decimal(14, 2)
  firstOrderAt   DateTime?
  lastOrderAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, shopifyId])
  @@index([storeId, email])
  @@index([storeId, country])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(cuid())
  storeId           String
  shopifyId         String?
  orderNumber       String?
  customerId        String?
  channel           SalesChannel @default(SHOPIFY)

  currency        String  @default("EUR") @db.Char(3)
  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal @default(0) @db.Decimal(14, 2)
  shippingCharged Decimal @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal @default(0) @db.Decimal(14, 2)
  total           Decimal @default(0) @db.Decimal(14, 2)
  refundedTotal   Decimal @default(0) @db.Decimal(14, 2)

  // Cost breakdown (profit engine)
  cogsTotal         Decimal @default(0) @db.Decimal(14, 2)
  shippingCost      Decimal @default(0) @db.Decimal(14, 2)
  // packagingCost = bubbleMailer + card + sticker + freeGift (per-order overheads)
  packagingCost     Decimal @default(0) @db.Decimal(14, 2)
  paymentFees       Decimal @default(0) @db.Decimal(14, 2)
  attributedAdSpend Decimal @default(0) @db.Decimal(14, 2)
  influencerCost    Decimal @default(0) @db.Decimal(14, 2)
  otherCosts        Decimal @default(0) @db.Decimal(14, 2)

  grossProfit Decimal  @default(0) @db.Decimal(14, 2)
  netProfit   Decimal  @default(0) @db.Decimal(14, 2)
  marginPct   Decimal? @db.Decimal(7, 4)

  financialStatus   String?
  fulfillmentStatus String?
  paymentGateway    String?
  cancelledAt       DateTime?
  shippingCountry   String?
  shippingCity      String?

  processedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  refunds  Refund[]

  @@unique([storeId, shopifyId])
  @@index([storeId, processedAt])
  @@index([storeId, channel])
  @@index([storeId, financialStatus])
  @@index([customerId])
  @@map("orders")
}

enum SalesChannel {
  SHOPIFY
  MANUAL
  CLUB
  EVENT
  POPUP
  WHOLESALE
  INFLUENCER_GIFT
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  variantId     String?
  shopifyLineId String?
  title         String
  sku           String?
  quantity      Int
  unitPrice     Decimal @db.Decimal(14, 2)
  unitCost      Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  totalRevenue  Decimal @db.Decimal(14, 2)
  totalCost     Decimal @default(0) @db.Decimal(14, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  shopifyId   String?
  amount      Decimal  @db.Decimal(14, 2)
  reason      String?
  processedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────────
// STOCK MOVEMENTS
// ─────────────────────────────────────────────────────────────

model StockMovement {
  id              String            @id @default(cuid())
  storeId         String
  variantId       String?
  inventoryItemId String?
  type            StockMovementType
  quantity        Int
  reference       String?
  note            String?
  createdAt       DateTime          @default(now())
  createdBy       String?           @db.Uuid

  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([variantId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  PURCHASE
  SHOPIFY_SALE
  MANUAL_SALE
  CLUB_SALE
  INFLUENCER_GIFT
  RETURN
  ADJUSTMENT
  LOSS
}

// ─────────────────────────────────────────────────────────────
// PHYSICAL INVENTORY — real warehouse items + bill-of-materials
// Several sellable variants can share one physical item (e.g. M shin pad).
// Packs consume multiple physical items via VariantComponent recipes.
// ─────────────────────────────────────────────────────────────

model InventoryItem {
  id           String   @id @default(cuid())
  storeId      String
  code         String // "BUILTIN-M", "GRIP-AMARELO-ADULTO-3640"
  name         String // "Built-In Shin Pad M"
  family       String // "Built-In Shin Pads" (grouping)
  stockOnHand  Int      @default(0)
  unitCost     Decimal? @db.Decimal(14, 2)
  reorderPoint Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  components VariantComponent[]
  movements  StockMovement[]

  @@unique([storeId, code])
  @@index([storeId, family])
  @@map("inventory_items")
}

model VariantComponent {
  id              String @id @default(cuid())
  variantId       String
  inventoryItemId String
  quantity        Int // physical units consumed per 1 sale of the variant

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([variantId, inventoryItemId])
  @@index([variantId])
  @@map("variant_components")
}

// ─────────────────────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  contact   String?
  email     String?
  phone     String?
  country   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────
// PURCHASE ORDERS — supplier orders / stock imports
// ─────────────────────────────────────────────────────────────

model PurchaseOrder {
  id          String   @id @default(cuid())
  storeId     String
  orderNumber Int
  date        DateTime
  supplier    String
  totalCost   Decimal  @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items PurchaseOrderItem[]

  @@index([storeId, date])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productName    String
  quantity       Int?
  productionCost Decimal? @db.Decimal(14, 2)
  transportCost  Decimal? @db.Decimal(14, 2)
  totalCost      Decimal  @db.Decimal(14, 2)
  unitCost       Decimal? @db.Decimal(14, 2)
  note           String?

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────
// CLUBS — physical sales channels with configurable commission tiers
// commissionTiers JSON: [{upTo: 100, rate: 0.25}, {upTo: 300, rate: 0.30}, {upTo: null, rate: 0.35}]
// Progressive (like tax brackets): each tier's rate applies only to the slice within its band.
// Rio Tinto: commissionEnabled=false
// ─────────────────────────────────────────────────────────────

model Club {
  id                String   @id @default(cuid())
  storeId           String
  name              String
  commissionEnabled Boolean  @default(true)
  commissionTiers   Json     @default("[{\"upTo\":100,\"rate\":0.25},{\"upTo\":300,\"rate\":0.30},{\"upTo\":null,\"rate\":0.35}]")
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productPrices ClubProductPrice[]
  sales         ManualSale[]

  @@index([storeId, isActive])
  @@map("clubs")
}

// Per-club pricing per product (not per variant — pricing is at product level)
model ClubProductPrice {
  id        String  @id @default(cuid())
  clubId    String
  productId String
  unitPrice Decimal @db.Decimal(14, 2)

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clubId, productId])
  @@map("club_product_prices")
}

// ─────────────────────────────────────────────────────────────
// MANUAL SALES (clubs, events, popups, wholesale, personal)
// ─────────────────────────────────────────────────────────────

model ManualSale {
  id           String      @id @default(cuid())
  storeId      String
  channel      SalesChannel
  clubId       String?     // FK to Club (only when channel=CLUB)
  eventName    String?
  customerName String?
  notes        String?

  currency    String  @default("EUR") @db.Char(3)
  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @default(0) @db.Decimal(14, 2)
  cogsTotal   Decimal @default(0) @db.Decimal(14, 2)
  grossProfit Decimal @default(0) @db.Decimal(14, 2)
  otherCosts  Decimal @default(0) @db.Decimal(14, 2)
  netProfit   Decimal @default(0) @db.Decimal(14, 2)

  soldAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  club  Club?            @relation(fields: [clubId], references: [id], onDelete: SetNull)
  items ManualSaleItem[]

  @@index([storeId, soldAt])
  @@index([storeId, channel])
  @@index([clubId, soldAt])
  @@map("manual_sales")
}

model ManualSaleItem {
  id           String  @id @default(cuid())
  manualSaleId String
  variantId    String
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  unitCost     Decimal @default(0) @db.Decimal(14, 2)
  totalRevenue Decimal @db.Decimal(14, 2)
  totalCost    Decimal @default(0) @db.Decimal(14, 2)

  sale    ManualSale     @relation(fields: [manualSaleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([manualSaleId])
  @@map("manual_sale_items")
}

// ─────────────────────────────────────────────────────────────
// AD CAMPAIGNS
// ─────────────────────────────────────────────────────────────

model AdCampaign {
  id         String     @id @default(cuid())
  storeId    String
  provider   AdProvider
  externalId String
  name       String
  objective  String?
  status     String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  metrics AdMetric[]

  @@unique([storeId, provider, externalId])
  @@index([storeId, provider])
  @@map("ad_campaigns")
}

enum AdProvider {
  META
  GOOGLE
  TIKTOK
}

model AdMetric {
  id                String   @id @default(cuid())
  campaignId        String
  date              DateTime @db.Date
  spend             Decimal  @default(0) @db.Decimal(14, 2)
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  purchases         Int      @default(0)
  attributedRevenue Decimal  @default(0) @db.Decimal(14, 2)
  roas              Decimal? @db.Decimal(10, 4)
  cpa               Decimal? @db.Decimal(14, 2)
  ctr               Decimal? @db.Decimal(7, 4)
  cpc               Decimal? @db.Decimal(14, 2)
  cpm               Decimal? @db.Decimal(14, 2)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@map("ad_metrics")
}

// ─────────────────────────────────────────────────────────────
// INFLUENCERS
// ─────────────────────────────────────────────────────────────

model Influencer {
  id               String           @id @default(cuid())
  storeId          String
  name             String
  handle           String?          // @username (primary platform)
  platform         String?          // instagram | tiktok | youtube | other
  instagram        String?
  tiktok           String?
  email            String?
  country          String?
  followers        Int?
  engagementRate   Decimal?         @db.Decimal(7, 4)
  discountCode     String?          // discount code they use / promote
  affiliateLink    String?
  attributedRevenue Decimal         @default(0) @db.Decimal(14, 2) // manually tracked revenue
  status           InfluencerStatus @default(PROSPECT)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipments InfluencerShipment[]
  payments  InfluencerPayment[]

  @@index([storeId, status])
  @@map("influencers")
}

enum InfluencerStatus {
  PROSPECT
  CONTACTED
  ACTIVE
  COMPLETED
  PAUSED
  BLACKLIST
}

model InfluencerShipment {
  id              String      @id @default(cuid())
  storeId         String
  influencerId    String
  trackingNumber  String?
  carrier         String?
  shippingCost    Decimal     @default(0) @db.Decimal(14, 2)
  status          ShipmentStatus @default(PREPARING)
  contentType     ContentType? // type of content expected / received
  sentAt          DateTime?
  deliveredAt     DateTime?
  contentPostedAt DateTime?
  contentUrl      String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store      Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  influencer Influencer               @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  items      InfluencerShipmentItem[]

  @@index([storeId, status])
  @@index([influencerId])
  @@map("influencer_shipments")
}

enum ShipmentStatus {
  PREPARING
  SENT
  DELIVERED
  POSTED
  NO_POST
  CANCELLED
}

enum ContentType {
  VIDEO_AD
  STORY
  POST
  REEL
  UGC
  NO_POST
}

model InfluencerShipmentItem {
  id         String  @id @default(cuid())
  shipmentId String
  variantId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(14, 2)

  shipment InfluencerShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variant  ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("influencer_shipment_items")
}

model InfluencerPayment {
  id           String   @id @default(cuid())
  influencerId String
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("EUR") @db.Char(3)
  method       String?
  paidAt       DateTime
  note         String?
  createdAt    DateTime @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, paidAt])
  @@map("influencer_payments")
}

// ─────────────────────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────────────────────

model Expense {
  id              String          @id @default(cuid())
  storeId         String
  createdById     String?         @db.Uuid
  category        ExpenseCategory
  vendor          String?
  description     String?
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @default("EUR") @db.Char(3)
  incurredOn      DateTime        @db.Date
  recurring       Boolean         @default(false)
  recurringPeriod RecurringPeriod?
  invoiceUrl      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, incurredOn])
  @@index([storeId, category])
  @@map("expenses")
}

enum ExpenseCategory {
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  SOFTWARE
  SHOPIFY_APPS
  FREELANCERS
  SUPPLIERS
  BULK_INVENTORY
  SHIPPING
  PACKAGING
  INFLUENCERS
  SUBSCRIPTIONS
  TAXES
  RENT
  TRAVEL
  EVENTS
  MISC
}

enum RecurringPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ─────────────────────────────────────────────────────────────
// UPLOADS
// ─────────────────────────────────────────────────────────────

model Upload {
  id          String       @id @default(cuid())
  storeId     String
  filename    String
  storagePath String
  mimeType    String?
  size        Int?
  purpose     UploadPurpose
  status      UploadStatus @default(PENDING)
  meta        Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, purpose])
  @@map("uploads")
}

enum UploadPurpose {
  EXPENSE_IMPORT
  ORDER_IMPORT
  INFLUENCER_IMPORT
  PRODUCT_IMPORT
  INVOICE
  OTHER
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS SNAPSHOTS — pre-computed daily rollups
// Covers both ecommerce (Shopify) and physical sales.
// ─────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id               String   @id @default(cuid())
  storeId          String
  date             DateTime @db.Date

  // Ecommerce (Shopify)
  revenue          Decimal  @default(0) @db.Decimal(14, 2)
  orders           Int      @default(0)
  cogs             Decimal  @default(0) @db.Decimal(14, 2)
  adSpend          Decimal  @default(0) @db.Decimal(14, 2)
  shippingCost     Decimal  @default(0) @db.Decimal(14, 2)
  fees             Decimal  @default(0) @db.Decimal(14, 2)
  influencerCost   Decimal  @default(0) @db.Decimal(14, 2)
  otherExpenses    Decimal  @default(0) @db.Decimal(14, 2)
  refunds          Decimal  @default(0) @db.Decimal(14, 2)
  grossProfit      Decimal  @default(0) @db.Decimal(14, 2)
  netProfit        Decimal  @default(0) @db.Decimal(14, 2)
  customers        Int      @default(0)
  newCustomers     Int      @default(0)

  // Physical sales (clubs + self)
  physicalRevenue  Decimal  @default(0) @db.Decimal(14, 2)
  physicalCogs     Decimal  @default(0) @db.Decimal(14, 2)
  physicalProfit   Decimal  @default(0) @db.Decimal(14, 2)
  clubCommissions  Decimal  @default(0) @db.Decimal(14, 2)

  computedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId, date])
  @@map("analytics_snapshots")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now())

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// GRWM SCHEDULED POSTS — Vercel Cron publishes at 17:00 UTC (18:00 Lisbon)
// ─────────────────────────────────────────────────────────────

model GrwmScheduledPost {
  id             String    @id @default(cuid())
  storeId        String
  scheduledDate  DateTime  @db.Date
  videoUrl       String
  caption        String
  igId           String
  published      Boolean   @default(false)
  igMediaId      String?
  tiktokPublishId String?
  fbPostId       String?
  publishedAt    DateTime?
  errorMsg       String?
  createdAt      DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, scheduledDate])
  @@index([storeId, published])
  @@map("grwm_scheduled_posts")
}
